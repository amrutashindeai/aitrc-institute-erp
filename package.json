{
  "name": "institute-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Role-based Institute ERP for academic planning, activity, evidence and compliance management",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "check:syntax": "npm --prefix backend run lint:syntax",
    "create-admin": "npm --prefix backend run create-admin",
    "seed": "npm --prefix backend run seed"
  }
}
